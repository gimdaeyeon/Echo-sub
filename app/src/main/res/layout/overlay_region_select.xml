<?xml version="1.0" encoding="utf-8"?>
<!-- 자막 읽기 영역 선택 상자. 창 자체가 곧 영역이다 — 위치/크기는
     RegionSelectOverlay가 WindowManager.LayoutParams로 조절한다.
     상자 내부 드래그 = 이동, 오른쪽 아래 손잡이 = 크기 조절, 체크 = 확정. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/region_select_background">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/region_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/overlay_region_hint"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:shadowColor="#000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3" />

        <ImageView
            android:id="@+id/region_btn_confirm"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:padding="6dp"
            android:src="@drawable/ic_region_confirm"
            android:background="@drawable/overlay_icon_button_background"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/overlay_region_confirm_description" />
    </LinearLayout>

    <ImageView
        android:id="@+id/region_handle_resize"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="bottom|end"
        android:padding="8dp"
        android:src="@drawable/ic_region_resize"
        android:contentDescription="@string/overlay_region_resize_description" />

</FrameLayout>
