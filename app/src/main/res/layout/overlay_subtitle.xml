<?xml version="1.0" encoding="utf-8"?>
<!-- 폭은 SubtitleOverlay가 WindowManager.LayoutParams.width로 정한다(핀치로 조절).
     여기서는 match_parent로 두어 그 폭을 그대로 채운다.

     루트가 PinchToResizeLayout인 이유: 두 손가락 핀치를 박스 어디에서든 받기 위해서다.
     손잡이 줄에서만 받으면 좁아서 사실상 핀치가 안 됐다.

     2단 구성: 위에 지금 들리는 원문(확정 + 인식 중), 아래에 번역 히스토리.
     원문은 말하는 속도로, 번역은 그보다 1~2초 늦게 도착한다 — 속도가 다른 두 흐름을
     한 칸에 섞으면 번역이 도착할 때마다 원문 읽던 자리가 밀린다. 칸을 나누면 각자
     자기 속도로 흐른다. -->
<com.example.echosub.overlay.PinchToResizeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/overlay_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/overlay_background"
    android:paddingHorizontal="14dp"
    android:paddingVertical="10dp">

    <!-- 창을 옮기는 손잡이. 아래 자막 영역이 자체 스크롤을 가지므로 박스 전체로는
         드래그를 받을 수 없다 — 이 줄(아이콘 + 그 왼쪽 빈 공간)만 드래그/핀치를
         받는다. 아이콘 자체는 자기 클릭 리스너가 먼저 소비하므로 평소대로 눌린다. -->
    <LinearLayout
        android:id="@+id/overlay_handle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:minHeight="28dp"
        android:layout_marginBottom="6dp">

        <!-- 상단 원문 영역 보이기/숨기기 — "번역만 보기" 토글. 꺼진 상태는 알파로 표시한다. -->
        <ImageView
            android:id="@+id/overlay_btn_source"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="6dp"
            android:padding="5dp"
            android:src="@drawable/ic_overlay_source"
            android:background="@drawable/overlay_icon_button_background"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/overlay_source_toggle_hide" />

        <!-- 화면 자막 모드에서만 보인다 — 실시간 자막 창을 옮겼을 때 읽기 영역을 다시 맞춘다. -->
        <ImageView
            android:id="@+id/overlay_btn_region"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="6dp"
            android:padding="5dp"
            android:src="@drawable/ic_overlay_region"
            android:background="@drawable/overlay_icon_button_background"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            android:contentDescription="@string/overlay_adjust_region_description" />

        <ImageView
            android:id="@+id/overlay_btn_open_app"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:padding="5dp"
            android:src="@drawable/ic_overlay_open_app"
            android:background="@drawable/overlay_icon_button_background"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/overlay_open_app_description" />

        <ImageView
            android:id="@+id/overlay_btn_toggle_pause"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:padding="5dp"
            android:src="@drawable/ic_overlay_pause"
            android:background="@drawable/overlay_icon_button_background"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/overlay_pause_description" />
    </LinearLayout>

    <!-- 상단: 지금 들리는 원문. 확정 문장은 또렷하게, 인식 중(interim) 텍스트는
         옅은 이탤릭으로 실시간으로 흐른다 — 번역이 돌아오기 전에도 글자가 움직여야
         "일하고 있다"가 보인다.

         이 영역도 높이 상한 스크롤로 감싼다 — 글자 수 상한만으로는 좁은 박스에서
         줄 수가 얼마든지 늘어나, 말이 빠르게 쌓이면 원문이 박스를 밀어 아래
         번역 영역이 화면 밖으로 잘렸다. 상한은 SubtitleOverlay(show())가 건다. -->
    <com.example.echosub.overlay.MaxHeightScrollView
        android:id="@+id/overlay_source_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:overScrollMode="never">

        <TextView
            android:id="@+id/overlay_source"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:lineSpacingExtra="3dp"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:shadowColor="#000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"
            tools:text="This never gets old for me.\nMmm." />
    </com.example.echosub.overlay.MaxHeightScrollView>

    <View
        android:id="@+id/overlay_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="8dp"
        android:background="#33FFFFFF" />

    <!-- 하단: 번역 히스토리. 위로 스크롤해 지난 문장을 다시 볼 수 있다. 높이 상한은
         MaxHeightScrollView가 코드(show())에서 건다. -->
    <com.example.echosub.overlay.MaxHeightScrollView
        android:id="@+id/overlay_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="vertical"
        android:overScrollMode="ifContentScrolls">

        <TextView
            android:id="@+id/overlay_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:lineSpacingExtra="5dp"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:shadowColor="#000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"
            tools:text="음.\n맛있어.\n이건 나한테는 언제 해도 질리지 않아." />
    </com.example.echosub.overlay.MaxHeightScrollView>

</com.example.echosub.overlay.PinchToResizeLayout>
