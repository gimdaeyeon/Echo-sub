<?xml version="1.0" encoding="utf-8"?>
<!-- 폭은 SubtitleOverlay가 WindowManager.LayoutParams.width로 정한다(핀치로 조절).
     여기서는 match_parent로 두어 그 폭을 그대로 채운다. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/overlay_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/overlay_background"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">

    <!-- 창을 옮기는 손잡이. 아래 자막 영역이 자체 스크롤을 가지게 되면서 더는 박스
         전체로 드래그를 받을 수 없다 — 이 줄(아이콘 + 그 왼쪽 빈 공간)만 드래그/핀치를
         받는다. 아이콘 자체는 자기 클릭 리스너가 먼저 소비하므로 평소대로 눌린다. -->
    <LinearLayout
        android:id="@+id/overlay_handle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:minHeight="28dp"
        android:layout_marginBottom="4dp">

        <ImageView
            android:id="@+id/overlay_btn_open_app"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:padding="5dp"
            android:src="@drawable/ic_overlay_open_app"
            android:background="@drawable/overlay_icon_button_background"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/overlay_open_app_description" />

        <ImageView
            android:id="@+id/overlay_btn_toggle_pause"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:padding="5dp"
            android:src="@drawable/ic_overlay_pause"
            android:background="@drawable/overlay_icon_button_background"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/overlay_pause_description" />
    </LinearLayout>

    <!-- 최근 문장 몇 개를 위로 스크롤해 다시 볼 수 있다. 높이 상한은 MaxHeightScrollView가
         코드(setEntries 호출 전 show())에서 건다. -->
    <com.example.echosub.overlay.MaxHeightScrollView
        android:id="@+id/overlay_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="vertical"
        android:overScrollMode="ifContentScrolls">

        <TextView
            android:id="@+id/overlay_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:shadowColor="#000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"
            tools:text="자막 대기 중…" />
    </com.example.echosub.overlay.MaxHeightScrollView>

</LinearLayout>
